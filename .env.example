# --- Shared ---
NODE_ENV=development

# --- Docker host ports (change if one is already taken on your machine) ---
# POSTGRES_PORT=5432
# REDIS_PORT=6379

# Base image for the api/web builds; set a mirror if Docker Hub is blocked, e.g. NODE_IMAGE=docker.arvancloud.ir/node:22-slim
# NODE_IMAGE=node:22-slim

# --- API ---
API_PORT=4000
DATABASE_URL=postgresql://varaq:varaq@localhost:5432/varaq?schema=public
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-to-a-long-random-string
# Pepper mixed into phone/email hashes. Changing it invalidates all existing logins.
CONTACT_HASH_PEPPER=change-me-too
CORS_ORIGIN=http://localhost:3000
# Development only: use a fixed OTP instead of sending one, and echo it in the API response.
DEV_FIXED_OTP=123456
# Set to "true" to only allow registration with a circle invite code.
REQUIRE_INVITE=false

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:4000
