{
  "name": "varaq",
  "version": "0.1.0",
  "private": true,
  "description": "Varaq (ورق) — peer-to-peer physical book lending and personal bookshelf tracker",
  "license": "MIT",
  "scripts": {
    "dev": "pnpm infra && pnpm -r --parallel --filter @varaq/api --filter @varaq/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @varaq/api db:generate",
    "db:migrate": "pnpm --filter @varaq/api db:migrate",
    "db:seed": "pnpm --filter @varaq/api db:seed",
    "infra": "docker compose up -d postgres redis",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:deploy": "pnpm --filter @varaq/api db:deploy"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  },
  "packageManager": "pnpm@12.4.2"
}
